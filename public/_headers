# Nagłówki bezpieczeństwa dla plików statycznych (Cloudflare Pages).
# API (/api/*) dostaje własne nagłówki w functions/api/_middleware.ts.
#
# CSP – dlaczego takie wyjątki:
#   script-src 'unsafe-inline'      Next (eksport statyczny) wstawia skrypty inline z danymi strony; nonce nie da się dodać bez serwera.
#   'wasm-unsafe-eval'              dekodery geometrii (meshopt, Draco) i optymalizacja modeli to WebAssembly.
#   Dekoder Draco jest w /draco/ (własny serwer) – bez www.gstatic.com (Google).
#   challenges.cloudflare.com       Cloudflare Turnstile (anty-bot) w logowaniu i rejestracji: skrypt + ramka.
#   worker-src blob:                dekoder Draco działa w Workerze tworzonym z blob:.
#   googletagmanager / google-analytics / doubleclick / googleadservices – tagi Google (GA4, Ads, GTM); ładują się
#                                   WYŁĄCZNIE po zgodzie na cookies (src/lib/zgody.ts). Ramka /osadz – bez Google.
#   img-src / connect-src blob:     tekstury z plików GLB i podgląd wgrywanego modelu.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com https://td.doubleclick.net; worker-src 'self' blob:; connect-src 'self' blob: data: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.google.pl https://www.googleadservices.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Ustawienia panelu (wgrywanie modeli): biblioteka optymalizacji (gltf-transform -> ndarray)
# tworzy funkcje przez new Function, więc TYLKO tu dochodzi 'unsafe-eval'. Strona chroniona tokenem,
# bez treści od klientów. "! nagłówek" zdejmuje CSP z reguły /* i stawia własną.
/panel/ustawienia*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com https://td.doubleclick.net; worker-src 'self' blob:; connect-src 'self' blob: data: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.google.pl https://www.googleadservices.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Kuchnia 3D do osadzenia na stronach firm (iframe): ramka dozwolona na każdej stronie https.
# Zdejmujemy X-Frame-Options i CSP z reguły /* i stawiamy CSP z frame-ancestors https:.
/osadz*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; connect-src 'self' blob: data:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https: http://localhost:*
  X-Robots-Tag: noindex

# Panel i ustawienia: bez indeksowania w wyszukiwarkach.
/panel*
  X-Robots-Tag: noindex, nofollow
/podglad-maila*
  X-Robots-Tag: noindex, nofollow
