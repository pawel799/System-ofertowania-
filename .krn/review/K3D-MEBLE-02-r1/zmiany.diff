+/** Strona (lewa / prawa) – zawias drzwi jednoskrzydłowych, orientacja narożnika LeMans, bok waterfall. */
+export type StronaLP = "L" | "P";
+export const STRONY_LP: readonly StronaLP[] = ["L", "P"];
 export type Wnetrze = {
   front: RodzajFrontu;
   kolumny: Kolumna[];
