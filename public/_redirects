# Cloudflare Pages: linki klientów /oferta/<id> pokazują jedną statyczną stronę
# /oferta/view (rewrite 200, adres w przeglądarce się nie zmienia).
# Reguły działają od góry i "zawsze", nawet gdy plik istnieje, dlatego
# prawdziwe strony (demo, view i ich pliki .txt Next.js) są wyłączone wcześniej.
/oferta/demo      /oferta/demo      200
/oferta/demo.txt  /oferta/demo.txt  200
/oferta/view      /oferta/view      200
/oferta/view.txt  /oferta/view.txt  200
/oferta/:id       /oferta/view      200

# Konta firmowe (rejestracja, logowanie hasłem) jeszcze nie istnieją – jedno wejście do panelu
# (kod dostępu) i kontakt. Stare adresy prowadzą tam zamiast do martwych stron.
/logowanie        /panel     301
/rejestracja      /kontakt   301
/reset-hasla      /panel     301
