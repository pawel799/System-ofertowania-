# Nagłówki bezpieczeństwa dla plików statycznych (Cloudflare Pages).
# API (/api/*) dostaje własne nagłówki w functions/api/_middleware.ts.
#
# CSP – dlaczego takie wyjątki:
#   script-src 'unsafe-inline'      Next (eksport statyczny) wstawia skrypty inline z danymi strony; nonce nie da się dodać bez serwera.
#   'wasm-unsafe-eval'              dekodery geometrii (meshopt, Draco) i optymalizacja modeli to WebAssembly.
#   https://www.gstatic.com         dekoder Draco dla kuchni demo (drei pobiera go z gstatic).
#   worker-src blob:                dekoder Draco działa w Workerze tworzonym z blob:.
#   img-src / connect-src blob:     tekstury z plików GLB i podgląd wgrywanego modelu.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com; worker-src 'self' blob:; connect-src 'self' https://www.gstatic.com blob: data:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Ustawienia panelu (wgrywanie modeli): biblioteka optymalizacji (gltf-transform -> ndarray)
# tworzy funkcje przez new Function, więc TYLKO tu dochodzi 'unsafe-eval'. Strona chroniona tokenem,
# bez treści od klientów. "! nagłówek" zdejmuje CSP z reguły /* i stawia własną.
/panel/ustawienia*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://www.gstatic.com; worker-src 'self' blob:; connect-src 'self' https://www.gstatic.com blob: data:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Kuchnia 3D do osadzenia na stronach firm (iframe): ramka dozwolona na każdej stronie https.
# Zdejmujemy X-Frame-Options i CSP z reguły /* i stawiamy CSP z frame-ancestors https:.
/osadz*
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com; worker-src 'self' blob:; connect-src 'self' https://www.gstatic.com blob: data:; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https: http://localhost:*
  X-Robots-Tag: noindex

# Panel i ustawienia: bez indeksowania w wyszukiwarkach.
/panel*
  X-Robots-Tag: noindex, nofollow
/podglad-maila*
  X-Robots-Tag: noindex, nofollow
